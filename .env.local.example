# ─── Translation server (tools/translation-server/) ──────────────────────────
#
# The extension POSTs to this base + /web to extract page metadata via Caddy
# in front of zotero/translation-server.
#
# NOTE (2026-05-14): TS-6 deployed an auth-proxy that requires per-user EdDSA
# JWTs (Authorization: Bearer …). The legacy shared X-Milton-Key flow below
# is preserved structurally for BE-1 but returns 401 against prod. BE-4 will
# migrate the extension to fetch a per-save JWT from Milton's local connector.

# Production (TS-5 live since 2026-05-10).
VITE_TRANSLATE_BASE=https://translate.milton.so

# Local dev alternative — bring up tools/translation-server/ via docker compose
# (CADDY_HOST=http://localhost, MILTON_KEY set in its .env) then point at it.
# VITE_TRANSLATE_BASE=http://localhost

# Shared X-Milton-Key auth secret — current header until BE-4 migration.
# Local dev: copy from tools/translation-server/.env
# Production: 1Password "Milton Translation Server — MILTON_KEY (production)"
# (BE-4 will replace this with a per-save EdDSA JWT from the local connector.)
VITE_MILTON_KEY=your-translation-server-key-here
